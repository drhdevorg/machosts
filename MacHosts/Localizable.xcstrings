    },
    "This build cannot check the system transaction records. The pending apply is preserved and further applies remain blocked.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build cannot check the system transaction records. The pending apply is preserved and further applies remain blocked."
