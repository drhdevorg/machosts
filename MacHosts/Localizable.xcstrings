    "All current profiles, folders and deleted profiles are removed from the draft and replaced by the selected import as inactive profiles. A backup of the current workspace is saved first and can be restored here. The system hosts file is not changed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All current profiles, folders and deleted profiles are removed from the draft and replaced by the selected import as inactive profiles. A backup of the current workspace is saved first and can be restored here. The system hosts file is not changed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle aktuellen Profile, Ordner und gelöschten Profile werden aus dem Entwurf entfernt und durch den ausgewählten Import als inaktive Profile ersetzt. Zuvor wird eine Sicherung des aktuellen Arbeitsbereichs gespeichert, die hier wiederhergestellt werden kann. Die System-Hosts-Datei wird nicht verändert."
          }
        }
      }
    },
    "Workspace draft replaced. A backup was saved. Profiles remain inactive.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workspace draft replaced. A backup was saved. Profiles remain inactive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitsbereichsentwurf ersetzt. Eine Sicherung wurde gespeichert. Profile bleiben inaktiv."
          }
        }
      }
    },
