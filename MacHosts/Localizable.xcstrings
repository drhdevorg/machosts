    },
    "Workspace could not be opened for normal use. Its data has been preserved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workspace could not be opened for normal use. Its data has been preserved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Arbeitsbereich konnte nicht regulär geöffnet werden. Seine Daten bleiben erhalten."
          }
        }
      }
    },
    "Observation does not change the system file or resolve an interrupted apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Observation does not change the system file or resolve an interrupted apply."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beobachtung verändert die Systemdatei nicht und klärt keine unterbrochene Übernahme."
          }
        }
      }
    },
    "System file matches the last verified apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System file matches the last verified apply."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systemdatei entspricht der letzten bestätigten Übernahme."
          }
        }
      }
    },
    "System file changed externally.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System file changed externally."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systemdatei wurde extern geändert."
          }
        }
      }
    },
    "An interrupted apply requires recovery.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An interrupted apply requires recovery."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine unterbrochene Übernahme erfordert eine Wiederherstellung."
          }
        }
      }
    },
    "System file has not been checked.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System file has not been checked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systemdatei wurde noch nicht geprüft."
          }
