        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote-Inhalt ist schreibgeschützt. Dupliziere ihn als lokales Profil, um Zeilen zu bearbeiten. Eine Adressänderung verwirft den zwischengespeicherten Inhalt."
          }
        }
      }
