        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build kann die Systemtransaktionsnachweise nicht prüfen. Die offene Übernahme bleibt erhalten; weitere Übernahmen bleiben gesperrt."
          }
        }
      }
    },
    "The system file matches the state before the interrupted apply.": {
      "localizations": {
