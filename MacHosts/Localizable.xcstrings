        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systemdatei konnte nicht gelesen werden."
          }
        }
      }
    },
    "System file has an unsupported file type or link count.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System file has an unsupported file type or link count."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systemdatei hat einen nicht unterstützten Dateityp oder mehrere harte Verknüpfungen."
          }
        }
      }
    },
    "System file exceeds the read limit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System file exceeds the read limit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systemdatei überschreitet das Leselimit."
          }
        }
      }
    },
    "System file changed while it was being read.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System file changed while it was being read."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systemdatei wurde während des Lesens geändert."
          }
        }
      }
    },
    "File observation is unavailable. Restart observation to try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File observation is unavailable. Restart observation to try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateibeobachtung ist nicht verfügbar. Starte die Beobachtung erneut."
          }
        }
      }
    },
    "Check again": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check again"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut prüfen"
          }
        }
      }
    },
    "Restart observation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart observation"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beobachtung neu starten"
          }
        }
      }
    },
    "Matching file contents alone cannot establish whether the interrupted apply completed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matching file contents alone cannot establish whether the interrupted apply completed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passende Dateiinhalte allein belegen nicht, ob die unterbrochene Übernahme abgeschlossen wurde."
          }
        }
      }
    },
    "This build cannot check the system transaction records. The pending apply is preserved and further applies remain blocked.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build cannot check the system transaction records. The pending apply is preserved and further applies remain blocked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build kann die Systemtransaktionsnachweise nicht prüfen. Die offene Übernahme bleibt erhalten; weitere Übernahmen bleiben gesperrt."
          }
        }
      }
    },
    "The system file matches the state before the interrupted apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system file matches the state before the interrupted apply."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systemdatei entspricht dem Stand vor der unterbrochenen Übernahme."
          }
        }
      }
    },
    "The system file matches the intended result of the interrupted apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system file matches the intended result of the interrupted apply."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systemdatei entspricht dem geplanten Ergebnis der unterbrochenen Übernahme."
          }
        }
      }
    },
    "The system file matches neither state of the interrupted apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system file matches neither state of the interrupted apply."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systemdatei entspricht keinem der beiden Stände der unterbrochenen Übernahme."
          }
        }
      }
    },
    "The interrupted apply cannot be compared with a current file reading.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The interrupted apply cannot be compared with a current file reading."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die unterbrochene Übernahme ist kein Vergleich mit einem aktuellen Dateistand möglich."
          }
        }
      }
    }
  },
  "version": "1.0"
}
