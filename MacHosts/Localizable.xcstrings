    },
    "Remote content is downloaded into a read-only profile. It is not enabled and never changes the system file without a preview and authorization.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote content is downloaded into a read-only profile. It is not enabled and never changes the system file without a preview and authorization."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote-Inhalt wird in ein schreibgeschütztes Profil geladen. Es ist nicht aktiviert und ändert die Systemdatei nie ohne Vorschau und Autorisierung."
          }
        }
      }
    },
    "Remote content is read-only. Duplicate it as a local profile to edit lines. Changing the address discards the cached content.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote content is read-only. Duplicate it as a local profile to edit lines. Changing the address discards the cached content."
          }
